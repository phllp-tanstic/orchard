BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
TARGET_BINANCE_CHAIN_ID=56

# Local Postgres (docker-compose.yml). Never a real credential in this file.
# POSTGRES_USER is the Postgres image's bootstrap superuser, not an app role.
# It must NOT be set to "orchard_migrator" or "orchard_app" - those are
# non-superuser roles migration 007 creates (DEC-014). If the bootstrap user
# happens to share one of those names, migration 007's "create if not
# exists" check silently skips creating the real role, and dev never
# exercises the same NOLOGIN/non-superuser role CI and Supabase use
# (DEC-016). Suggested: orchard_admin.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Salt for hashing sensitive request params before they are stored in evidence.redacted_request.
EVIDENCE_REDACTION_SALT=

# orchard_app's login password, set via ALTER ROLE by db/migrate.ts after
# `migrate:up` (never written into a migration file). Used by packages/evidence
# to connect as the least-privileged application role.
ORCHARD_APP_DB_PASSWORD=
ORCHARD_APP_DATABASE_URL=
