BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
TARGET_BINANCE_CHAIN_ID=56

# Local Postgres (docker-compose.yml). Never a real credential in this file.
# POSTGRES_USER is the Postgres image's bootstrap superuser, not an app role.
# It must NOT be set to "orchard_migrator" or "orchard_app" - those are
# non-superuser roles migration 007 creates (DEC-014). If the bootstrap user
# happens to share one of those names, migration 007's "create if not
# exists" check silently skips creating the real role, and dev never
# exercises the same NOLOGIN/non-superuser role CI and Supabase use
# (DEC-016). Suggested: orchard_admin.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Salt for hashing sensitive request params before they are stored in evidence.redacted_request.
EVIDENCE_REDACTION_SALT=

# orchard_app's login password, set via ALTER ROLE by db/migrate.ts after
# `migrate:up` (never written into a migration file). Used by packages/evidence
# to connect as the least-privileged application role.
ORCHARD_APP_DB_PASSWORD=
ORCHARD_APP_DATABASE_URL=

# --- tools/probe-quote (pnpm probe:quote, F001-B T3). All optional; the
# defaults in tools/probe-quote/src/cli.ts are what a plain run uses.
#
# Read-only probe wallet sent as userWalletAddress. Default is the public BSC
# burn address 0x...dEaD, confirmed live to be accepted by /quote with no
# balance. Never set this to a wallet whose key you hold - F001-B signs nothing.
PROBE_WALLET_ADDRESS=
# Spend token and its decimals. Default is USDT on BSC at 18 decimals; the
# probe verifies both against each quote response and reports a disagreement.
PROBE_SPEND_TOKEN_ADDRESS=
PROBE_SPEND_TOKEN_DECIMALS=
# Comma-separated whole-USD spend sizes. Default 10,100,1000.
PROBE_SPEND_SIZES_USD=
# Seed for the single-representation sample draw (reproducibility).
PROBE_SEED=
# Single-representation tickers sampled per platform. Default 10.
PROBE_SINGLE_REP_PER_PLATFORM=
# quoteId-reuse/TTL observations per run. Each costs a >30s wait. Default 1.
PROBE_TTL_OBSERVATIONS=
# slippagePercent sent on every /swap. Live /swap rejects a request carrying
# neither slippagePercent nor autoSlippage (code 40001), though the doc page
# lists both as optional. Default 0.5.
PROBE_SLIPPAGE_PERCENT=
