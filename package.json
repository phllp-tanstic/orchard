{
  "name": "orchard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Orchard: banking-style consumer investment account for tokenized stocks on BNB Chain.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:up": "tsx db/migrate.ts up",
    "migrate:down": "tsx db/migrate.ts down",
    "evidence:export": "tsx packages/evidence/src/export-cli.ts",
    "probe:rwa": "tsx tools/probe/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
